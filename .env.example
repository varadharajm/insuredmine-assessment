PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/insuredmine

# Time zone used to read "day" + "time" in the scheduling API
TZ=Asia/Kolkata

# CPU auto-restart
CPU_THRESHOLD=70
CPU_CHECK_INTERVAL_MS=1000
CPU_BREACH_COUNT=3
CPU_WARMUP_MS=10000

# Scheduled messages poll interval
SCHEDULER_POLL_MS=1000

# Set to true to enable POST /api/system/stress (demo of the auto-restart)
ENABLE_STRESS_ENDPOINT=false
